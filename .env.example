# Copy to .env.local and fill in. NEXT_PUBLIC_* is exposed to the browser;
# everything else is server-only.
#
# Only the four vars marked REQUIRED are needed to boot the app and log in.
# Add OPENAI_API_KEY + TAVILY_API_KEY to actually generate a report.
# Every other integration degrades quietly when unset rather than crashing.

# ── Supabase (REQUIRED) ───────────────────────────────────────────────────────
# One shared project across local, CI and production — there is no staging DB.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # server-only, bypasses RLS — never expose

# ── App URL (REQUIRED — share links, email links, usage alerts) ───────────────
NEXT_PUBLIC_BASE_URL=        # http://localhost:3000 in dev, https://roi.lyrise.ai in prod

# ── ROI pipeline ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=              # needed to generate a report
TAVILY_API_KEY=              # primary web search (1k free/month)
BRAVE_API_KEY=               # optional — fallback web search (2k free/month)

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=                  # e.g. reports@roi.lyrise.ai (defaults to this if unset)

# ── Linear ────────────────────────────────────────────────────────────────────
# Used by /api/linear/triage to file in-app feedback as Triage issues.
# If LINEAR_API_KEY or LINEAR_TEAM_ID is missing the route logs a warning and
# returns 200 — feedback silently stops reaching Linear, so check these first
# when issues stop appearing.
LINEAR_API_KEY=
LINEAR_TEAM_ID=              # internal team UUID (GraphQL API)
LINEAR_TRIAGE_STATE_ID=      # workflow state ID for Triage on that team
LINEAR_FEEDBACK_LABEL_ID=    # label applied automatically to feedback issues
# Base "new issue" URL for the team, used only by the alpha dashboard's
# "What to fix" list to build pre-filled issue links, e.g.
# https://linear.app/<workspace-slug>/team/<TEAM-KEY>/new
# This is the human-facing workspace/team slug for a browser URL — distinct
# from LINEAR_TEAM_ID above. The two are not interchangeable.
LINEAR_NEW_ISSUE_URL=

# ── Sentry (client extras are opt-in) ─────────────────────────────────────────
# Replay and Feedback add noticeable shared JavaScript to every page.
# The DSN itself is hardcoded in sentry.*.config.ts / instrumentation-client.ts.
NEXT_PUBLIC_SENTRY_ENABLED=true
NEXT_PUBLIC_SENTRY_REPLAY=false
NEXT_PUBLIC_SENTRY_FEEDBACK=true

# ── Analytics / env ───────────────────────────────────────────────────────────
NEXT_PUBLIC_ENV=production   # production | ci | unset (dev)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_AMPLITUDE=

# ── Webhooks ──────────────────────────────────────────────────────────────────
N8N_FEEDBACK_WEBHOOK_URL=

# ── Alerts (prod only — leave blank in dev) ───────────────────────────────────
ROI_USAGE_ALERT_EMAILS=          # LLM spend threshold alerts
ROI_REPORT_ACCESS_ALERT_EMAILS=  # report-viewed alerts
# ROI_USAGE_ALERT_THRESHOLD_USD=10
# ROI_USAGE_ALERT_WINDOW_DAYS=30
# ROI_USAGE_ALERTS_IN_DEV=true   # alerts are suppressed in dev unless this is set

# ── E2E / Playwright tests ────────────────────────────────────────────────────
# Email + password of a real Supabase user that can log in. Used by globalSetup
# to create the authenticated session for dashboard / roi-report-form tests.
# Mirror these as GitHub secrets in the "Production" environment.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# ── Dev/debug ─────────────────────────────────────────────────────────────────
# DEV_ALERT_EMAILS=                 # recipients for /api/notify-error alerts
# ROI_DEBUG=true                    # verbose pipeline logging
# NEXT_PUBLIC_ROI_MIN_LOADER_MS=3500  # lower this while working on generation
