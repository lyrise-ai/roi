# Copy to .env.local and fill in. NEXT_PUBLIC_* is exposed to the browser;
# everything else is server-only.
#
# Only the four vars marked REQUIRED are needed to boot the app and log in.
# Add OPENAI_API_KEY + TAVILY_API_KEY to actually generate a report.
# Every other integration degrades quietly when unset rather than crashing.

# ── Supabase (REQUIRED) ───────────────────────────────────────────────────────
# One shared project across local, CI and production — there is no staging DB.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # server-only, bypasses RLS — never expose

# ── App URL (REQUIRED — share links, email links, usage alerts) ───────────────
NEXT_PUBLIC_BASE_URL=        # http://localhost:3000 in dev, https://roi.lyrise.ai in prod

# ── ROI pipeline ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=              # needed to generate a report
TAVILY_API_KEY=              # primary web search (1k free/month)
BRAVE_API_KEY=               # optional — fallback web search (2k free/month)

# ── Profit Map research system (LYR-187) ──────────────────────────────────────
# Every key here is OPTIONAL. Each one switches on one tier of a cascade, and
# a tier whose key is missing reports `outcome: 'miss'` and hands off to the
# next — so the whole system runs, and is testable, with all four left blank.
# Adding a key later is config, never code. Check src/lib/roi/research/env.ts
# for the single place that reads them.
#
# What still works with nothing set here:
#   S2 job postings — the six ATS APIs are public and unauthenticated, and
#     careers pages are fetched directly. This is the highest-value scout and
#     it needs no key at all.
#   S1 firmographics — falls back to the company's own site: country from the
#     TLD and the footer address, vertical from page metadata. Degraded, not
#     broken (status PARTIAL, confidence low).
#
# What each key buys:
FIRECRAWL_API_KEY=           # Fallback fetch ONLY, for sites that block a plain
                             # request or render with JS (GCC firms especially —
                             # altamimi.com 403s a normal fetch). Static sites go
                             # through the artifact cache's own fetch, so the free
                             # tier's 1k credits/month is far more than the POC
                             # needs. Self-hosting is not an option: Firecrawl is
                             # Docker Compose across Playwright + Redis + RabbitMQ
                             # + Postgres, ~8GB RAM, and does not support
                             # serverless — this app is Vercel-only by design.
PDL_API_KEY=                 # People Data Labs. Free tier is 100 company lookups
                             # a month and only charges on a successful match.
APOLLO_API_KEY=              # Requires an Apollo *Organization* plan — Basic and
                             # Professional cannot call the API at all. Leave
                             # blank unless we're on Organization.
EXPLORIUM_API_KEY=           # Enterprise contract only; no self-serve tier.
#
# NEVER add a LinkedIn or Proxycurl key. Proxycurl was shut down in July 2025
# after LinkedIn's federal lawsuit, and we sell to law firms. No path in the
# research system may call LinkedIn.

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=                  # e.g. reports@roi.lyrise.ai (defaults to this if unset)
ALLOW_OUTBOUND_EMAIL=        # 1 to actually send from a local machine. Without it,
                             # src/lib/outboundEmail.ts suppresses every send outside
                             # production, so a test run can't reach a real inbox.

# ── Linear ────────────────────────────────────────────────────────────────────
# Used by /api/linear/triage to file in-app feedback as Triage issues.
# If LINEAR_API_KEY or LINEAR_TEAM_ID is missing the route logs a warning and
# returns 200 — feedback silently stops reaching Linear, so check these first
# when issues stop appearing.
LINEAR_API_KEY=
LINEAR_TEAM_ID=              # internal team UUID (GraphQL API)
LINEAR_TRIAGE_STATE_ID=      # workflow state ID for Triage on that team
LINEAR_FEEDBACK_LABEL_ID=    # label applied automatically to feedback issues
# Base "new issue" URL for the team, used only by the alpha dashboard's
# "What to fix" list to build pre-filled issue links, e.g.
# https://linear.app/<workspace-slug>/team/<TEAM-KEY>/new
# This is the human-facing workspace/team slug for a browser URL — distinct
# from LINEAR_TEAM_ID above. The two are not interchangeable.
LINEAR_NEW_ISSUE_URL=

# ── Sentry (the deep dive, not the front door — see CLAUDE.md) ────────────────
# The DSN itself is hardcoded in sentry.*.config.ts / instrumentation-client.ts.
# There is no NEXT_PUBLIC_SENTRY_REPLAY any more: replay is PostHog's job, and
# Sentry's is pinned to 0 so we never pay two vendors to record one session.
NEXT_PUBLIC_SENTRY_ENABLED=true
NEXT_PUBLIC_SENTRY_FEEDBACK=true

# ── Analytics / env ───────────────────────────────────────────────────────────
NEXT_PUBLIC_ENV=production   # production | ci | unset (dev)
# PostHog is the front door for observability: product analytics, session
# replay, and the error list that raises Linear tickets. See CLAUDE.md for how
# the PostHog/Sentry split works.
#
# Everything PostHog no-ops without the project token, so leaving these blank
# is a supported state — that's how CI stays out of the production project.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Build-time only, for source-map upload. Without these a production stack
# trace is minified nonsense. Set them in Vercel; local builds skip the upload.
# POSTHOG_API_KEY is a *personal* API key with write access on error tracking.
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=

# Shared secret guarding POST /api/linear/triage (in-app feedback). Errors do
# not use this — PostHog's own Linear destination talks to Linear directly.
# Invent a long random string: openssl rand -hex 32
POSTHOG_WEBHOOK_SECRET=

# Sentry org slug. Only used to build PostHog -> Sentry deep links; if those
# links 404, this is the wrong value.
NEXT_PUBLIC_SENTRY_ORG=lyrise

# ── Webhooks ──────────────────────────────────────────────────────────────────
N8N_FEEDBACK_WEBHOOK_URL=

# ── Alerts (prod only — leave blank in dev) ───────────────────────────────────
ROI_USAGE_ALERT_EMAILS=          # LLM spend threshold alerts
ROI_REPORT_ACCESS_ALERT_EMAILS=  # report-viewed alerts
# ROI_USAGE_ALERT_THRESHOLD_USD=10
# ROI_USAGE_ALERT_WINDOW_DAYS=30
# ROI_USAGE_ALERTS_IN_DEV=true   # alerts are suppressed in dev unless this is set

# ── E2E / Playwright tests ────────────────────────────────────────────────────
# Email + password of a real Supabase user that can log in. Used by globalSetup
# to create the authenticated session for dashboard / roi-report-form tests.
# Mirror these as GitHub secrets in the "Production" environment.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# ── Dev/debug ─────────────────────────────────────────────────────────────────
# DEV_ALERT_EMAILS=                 # recipients for /api/notify-error alerts
# ROI_DEBUG=true                    # verbose pipeline logging
# NEXT_PUBLIC_ROI_MIN_LOADER_MS=3500  # lower this while working on generation
